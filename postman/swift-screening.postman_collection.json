            "body": { "mode": "raw", "raw": "{1:F01BANKGB2LAXXX0000000000}{2:I103DEUTDEFFXXXXN}{4:\r\n:23B:CRED\r\n:32A:261115EUR12500,00\r\n:50K:/DE89370400440532013000\r\nGormerqua Wilni\r\n:59:/DE89370400440532013000\r\nDenmonmon Textiles Ltd\r\n:71A:SHA\r\n-}" }
