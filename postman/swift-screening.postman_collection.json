{
  "info": {
    "name": "swift-screening (Phase 1)",
    "description": "Sample requests for the swift-screening API. Start the server with `uv run swift-screening serve` (or `docker compose up`), import this collection plus the environment file, then run it in order. All watchlist names used here are FICTIONAL fixtures from fixtures/lists.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('security headers present', () => {",
          "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
          "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health check",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/healthz" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 ok', () => pm.response.to.have.status(200));",
            "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
          ] } }]
        },
        {
          "name": "Readiness check",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/readyz" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('ready (lists loaded, DB up)', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().ready).to.be.true;",
            "});"
          ] } }]
        },
        {
          "name": "Prometheus metrics",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/metrics" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 text metrics', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.text()).to.include('# HELP');",
            "});"
          ] } }]
        },
        {
          "name": "List status",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/lists/status" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 array of lists', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json()).to.be.an('array');",
            "});"
          ] } }]
        }
      ]
    },
    {
