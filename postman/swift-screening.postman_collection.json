            "header": [{ "key": "Content-Type", "value": "text/plain" }],
            "url": "{{baseUrl}}/v1/screen/mt",
            "body": { "mode": "raw", "raw": "{1:F01BANKGB2LAXXX0000000000}{2:I103DEUTDEFFXXXXN}{3:{108:SYNTH}{121:00000000-0000-0000-0000-000000000007}}{4:\r\n:20:REF985440\r\n:23B:CRED\r\n:32A:261115EUR12500,00\r\n:50F:/DE89370400440532013000\r\n1/Gormerqua Wilni\r\n2/34 Station Street\r\n3/US/NEW YORK\r\n:52A:BANKGB2LXXX\r\n:57A:DEUTDEFFXXX\r\n:59F:/DE89370400440532013000\r\n1/Denmonmon Textiles Ltd\r\n2/59 Mill Lane\r\n3/SG/SINGAPORE\r\n:70:INVOICE 0\r\n:71A:SHA\r\n-}{5:{CHK:123456789ABC}}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
